seed                 12345
dimension            2
global               gridcut 0.0016 comm/sort yes
global               surfmax 10000

boundary             o o p 
create_box           -3 5 -4 4 -0.5 0.5
# as a test, can use 100 * 100 * 1 grid to visualize the results quickly
#create_grid         100 100 1
create_grid          800 800 1
balance_grid         block 1 * *

global               nrho 8.6626e+20 fnum 8.6626e+15
# only CO2 in the simulation
species              mars.species CO2  
mixture              air CO2 vstream 5600 0 0 temp 162.948

read_surf            surf.msl clip scale 1.0 1.0 1.0
surf_collide         wall diffuse 290 1
surf_modify          all collide wall
collide              vss all mars.vss relax variable
collide_modify       rotate smooth vibrate smooth

fix                  in emit/face air xlo ylo yhi 
timestep             3e-8

variable             Nsample equal 25000
variable             Namr equal 50000
variable             nstep equal 100000
variable             rmfp equal 2.0
variable             cmfp equal 4.0

compute              mfp grid all air nrho
fix                  mfp ave/grid all 1 ${Nsample} ${Nsample} c_mfp[*]
compute              lambda lambda/grid f_mfp NULL CO2 kx

# compute and fix for flow field properties
compute              flow grid all air n nrho u v w temp
fix                  flow ave/grid all 1 ${Nsample} ${Nsample} c_flow[*]
# compute and fix for surf properties
compute              surface surf all air n nflux nflux_incident mflux mflux_incident &
                     press ke erot evib etot
fix                  surface ave/surf all 1 ${Nsample} ${Nsample} c_surface[*]

# dump images
dump                 1 image all ${Namr} particle.*.png type type pdiam 0.005 &
                     surf f_surface[5] 0.002 size 1024 1024 zoom 1 &
                     gline no 0.0005 box yes 0.0025
dump_modify	     1 pad 4
dump                 2 image all ${Namr} mesh_and_particle.*.png type type particle yes pdiam 0.006 &
                     surf one 0.01 size 1024 1024 zoom 2.0 &
                     gline yes 0.0015 box yes 0.0025
dump                 3 image all ${Namr} flow_vx.*.png type type particle no grid f_flow[2] &
                     surf f_surface[5] 0.005 size 1024 1024 zoom 1.0 &
                     box yes 0.0025
dump_modify	     3 pad 4
# dump files
dump                4 grid all ${Namr} grid.*.data id f_flow[*]
dump_modify	    4 pad 4
dump                5 surf all ${Namr} surface.*.data id f_surface[*]
dump_modify	    5 pad 4

stats		     5
stats_style	     step cpu np nattempt ncoll nscoll nscheck
restart              ${Namr} msl.restart


run                  ${Namr}
adapt_grid           all refine coarsen value c_lambda[2] ${rmfp} ${cmfp} &
                     combine min thresh less more maxlevel 3 cells 2 2 1
balance_grid         rcb cell

run                  ${Namr}
adapt_grid           all refine coarsen value c_lambda[2] ${rmfp} ${cmfp} &
                     combine min thresh less more maxlevel 3 cells 2 2 1
balance_grid         rcb cell

run                  ${Namr}
adapt_grid           all refine coarsen value c_lambda[2] ${rmfp} ${cmfp} &
                     combine min thresh less more maxlevel 3 cells 2 2 1
balance_grid         rcb cell

run                  ${Namr}
adapt_grid           all refine coarsen value c_lambda[2] ${rmfp} ${cmfp} &
                     combine min thresh less more maxlevel 3 cells 2 2 1
balance_grid         rcb cell

run                  ${nstep}
